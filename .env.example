# Copy with `npm run setup:local`; generated keys stay in the ignored .env file.
HOST=127.0.0.1
PORT=8766
PUBLIC_ORIGIN=http://127.0.0.1:8766
DATABASE_PATH=.data/vodalens.sqlite
VODALENS_OWNER_ID=personal-owner
VODALENS_API_TOKEN=
VODALENS_VAULT_KEY=
# Active approach: hand off an access token from your normal My Vodafone login.
VODAFONE_AUTH_METHOD=myvodafone-session
# Off by default; research additionally needs a fresh one-time arm.
VODALENS_ENABLE_RENEWAL_RESEARCH=false
# Optional research path only. Vodafone has disabled dynamic registration.
VODAFONE_CLIENT_ID=
VODAFONE_TOKEN_AUTH_METHOD=none
VODAFONE_CLIENT_SECRET=
# Comma-separated exact origins; no wildcard. Add the future Edge addon origin
# only after its ID is known. Native clients do not depend on browser CORS.
ALLOWED_CLIENT_ORIGINS=
