{
  "manifest_version": 3,
  "name": "VodaLens — My Vodafone session bridge",
  "version": "0.1.0",
  "description": "Connect your signed-in My Vodafone session to your local VodaLens backend.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://my.vodafone.com.au/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect VodaLens",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.vodafone.com.au/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://my.vodafone.com.au/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:8766"
  }
}
